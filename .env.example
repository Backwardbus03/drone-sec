# ==============================================================================
# Drone Forensic Toolkit (DFT) — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values before running locally or
# deploying to Render.
#
# cp .env.example .env
# ==============================================================================


# ------------------------------------------------------------------------------
# LLM — Groq API (Primary AI engine)
# Free tier: https://console.groq.com  (sign up → API Keys → Create key)
# The free tier gives ~14,400 req/day with llama-3.3-70b-versatile.
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use (free tier supports all models listed below)
# Options: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile


# ------------------------------------------------------------------------------
# LLM — Ollama (Optional local fallback — only used when self-hosting)
# Leave default if not running Ollama; DFT will automatically skip it on Render.
# ------------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3


# ------------------------------------------------------------------------------
# Chain of Custody — HMAC Secret Key
# REQUIRED: Change this to a strong random secret before deploying.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
DFT_HMAC_SECRET=e526deda6688a8f04d8324306e2af913609aca391cfef252b1138435baab5ca7


# ------------------------------------------------------------------------------
# Persistent Storage — Render Disk Mount Path
# On Render Free tier, use a Render Disk (persistent volume) mounted at /data.
# Locally this defaults to the project-relative "forensic_cases_vault/" folder.
# ------------------------------------------------------------------------------
DFT_DATA_DIR=/data/forensic_cases_vault


# ------------------------------------------------------------------------------
# Vector Store — ChromaDB
# ChromaDB runs embedded (no separate server needed).
# The vector index is stored inside DFT_DATA_DIR/vector_db/ automatically.
# No additional config required.
# ------------------------------------------------------------------------------


# ------------------------------------------------------------------------------
# Application Server
# ------------------------------------------------------------------------------
# Host and port for the Uvicorn server (Render sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# Set to "production" on Render, "development" locally
ENVIRONMENT=production

# Comma-separated list of allowed CORS origins (* = allow all)
# Example: ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000
ALLOWED_ORIGINS=*


# ------------------------------------------------------------------------------
# HuggingFace Cache (sentence-transformers model: all-MiniLM-L6-v2)
# Render will download the model weights on first boot (~90 MB).
# Point to a persistent volume path to avoid re-downloading on each deploy.
# ------------------------------------------------------------------------------
HF_HOME=/data/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/data/.cache/sentence_transformers


# ------------------------------------------------------------------------------
# Security (Optional — future use)
# ------------------------------------------------------------------------------
# Secret key for future JWT / session signing
SECRET_KEY=CHANGE_ME_another_strong_random_secret

# API bearer token to protect endpoints (optional, leave blank to disable)
DFT_API_TOKEN=
